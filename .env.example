# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Provide your Replit PostgreSQL or cloud PostgreSQL connection string here
DATABASE_URL=postgresql://username:password@host:5432/database

# Authentication
# Generate a random string for secure JWT signing
JWT_SECRET=replace_with_a_long_random_secret

# AI Integration
# Your Google Gemini API Key (Backend Only)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Frontend Configuration
# URL of the Vite development server proxy / API endpoint
VITE_API_URL=http://localhost:5000/api
